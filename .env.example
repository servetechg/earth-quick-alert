# ─── Core ────────────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=ready2go
JWT_SECRET=

# ─── Cloudinary (continuity file storage) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Ready2Go AI Service (COOP/BC integrity + audit) ────────────────────────
# Default backend is the Python AI microservice. Set INTEGRITY_BACKEND=openai to
# use the legacy in-Next.js OpenAI path instead.
INTEGRITY_BACKEND=python
# Base URL of the AI service (alts: PYTHON_INTEGRITY_URL / AI_SERVICE_URL).
PYTHON_URL=http://localhost:8000
# Shared Bearer token — must match PYTHON_INTEGRITY_TOKEN on the AI service.
PYTHON_INTEGRITY_TOKEN=
# Optional: only set if the AI service has HMAC_SECRET configured (alt: HMAC_SECRET).
PYTHON_HMAC_SECRET=
# Optional: tenant key prefix (tenantKey = "<prefix><ownerUserId>"). Default 'sub_'.
PYTHON_TENANT_KEY_PREFIX=sub_
# Optional: client poll budget (ms) for the async analyze flow. Default 300000.
PYTHON_ANALYZE_POLL_TIMEOUT_MS=300000

# ─── OpenAI (plan metadata inference + INTEGRITY_BACKEND=openai fallback) ────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
